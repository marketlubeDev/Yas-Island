{
  "rewrites": [
    {
      "source": "/statics/Yas_Packages.html",
      "destination": "/statics/Yas_Packages.html"
    },
    {
      "source": "/statics/Yas_Dining.html",
      "destination": "/statics/Yas_Dining.html"
    },
    {
      "source": "/statics/Yas_Events.html",
      "destination": "/statics/Yas_Events.html"
    },
    {
      "source": "/statics/Yas_Hotels.html",
      "destination": "/statics/Yas_Hotels.html"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/all", "destination": "/index.html" },
    { "source": "/product/**", "destination": "/index.html" },
    { "source": "/email-verification", "destination": "/index.html" },
    { "source": "/otp-confirmation", "destination": "/index.html" },
    { "source": "/payment-details", "destination": "/index.html" },
    { "source": "/card-payment", "destination": "/index.html" },
    { "source": "/payment-success", "destination": "/index.html" },
    { "source": "/payment-response", "destination": "/index.html" },
    { "source": "/upcoming", "destination": "/index.html" },
    { "source": "/packages", "destination": "/index.html" },
    { "source": "/hotels", "destination": "/index.html" },
    { "source": "/dining", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/shopping", "destination": "/index.html" }
  ],
  "cleanUrls": false,
  "headers": [
    {
      "source": "/statics/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    }
  ]
}
